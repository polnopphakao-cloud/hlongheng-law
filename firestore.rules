rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ตรวจว่าผู้ใช้เข้าสู่ระบบแล้ว
    function isSignedIn() {
      return request.auth != null;
    }

    // ตรวจว่า UID ที่ร้องขอตรงกับ UID ของเอกสาร
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ตรวจว่ามีเอกสารผู้ดูแลและ active เป็น true
    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.active == true;
    }

    // =========================
    // ผู้ดูแลระบบ
    // =========================

match /admins/{adminUid} {

  // ผู้ใช้ตรวจได้เฉพาะเอกสาร Admin ที่มี UID ของตนเอง
  // ผู้ดูแลอ่านเอกสาร Admin ได้
  allow get: if isOwner(adminUid) || isAdmin();

  // การอ่านรายชื่อ Admin ทั้ง collection ให้เฉพาะ Admin
  allow list: if isAdmin();

  // ห้ามสร้าง แก้ หรือลบผ่านหน้าเว็บไซต์
  allow create, update, delete: if false;
}

    // =========================
    // ข้อมูลสมาชิก
    // =========================

    match /users/{userUid} {

      // เจ้าของบัญชีอ่านข้อมูลตนเองได้
      // ผู้ดูแลอ่านข้อมูลสมาชิกทุกคนได้
      allow get: if isOwner(userUid) || isAdmin();

      // การอ่านแบบรายการ สำหรับหน้า Admin Dashboard
      // อนุญาตเฉพาะผู้ดูแล
      allow list: if isAdmin();

      // ผู้ใช้สร้างเอกสารของตนเองได้เท่านั้น
      // และ UID ภายในเอกสารต้องตรงกับผู้เข้าสู่ระบบ
      allow create: if isOwner(userUid)

      // ผู้ใช้ทั่วไปแก้เฉพาะข้อมูลพื้นฐานของตนเอง
      // ห้ามแก้สิทธิ์ บทบาท และสถานะบัญชี
      allow update: if (
  isOwner(userUid)
  && request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly([
      'displayName',
      'photoURL',
      'questionUsed',
      'updatedAt'
    ])
  && request.resource.data.questionUsed
    == resource.data.questionUsed + 1
  && request.resource.data.questionUsed
    <= resource.data.questionLimit
) || isAdmin();

      // ผู้ดูแลเท่านั้นที่ลบเอกสารสมาชิกได้
      // แต่ในทางปฏิบัติแนะนำให้ใช้ suspended แทนการลบ
      allow delete: if isAdmin();
    }

    // =========================
    // ประวัติการแก้สิทธิ์คำถาม
    // =========================

    match /quotaLogs/{logId} {

      // ผู้ดูแลอ่านและสร้าง Log ได้
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.changedBy == request.auth.uid;

      // Log ที่สร้างแล้วห้ามแก้หรือลบ
      allow update: if isAdmin();
    allow delete: if false;
    }

    // =========================
    // ประวัติกิจกรรมผู้ดูแล
    // =========================

    match /adminLogs/{logId} {

      // เฉพาะผู้ดูแลอ่านประวัติได้
      allow read: if isAdmin();

      // ผู้ดูแลสร้างประวัติในชื่อตนเองเท่านั้น
      allow create: if isAdmin()
        && request.resource.data.adminUid == request.auth.uid;

      // ป้องกันการแก้หรือลบประวัติย้อนหลัง
      allow update, delete: if false;
    }
// =========================
// คำถามของสมาชิก
// =========================

match /questions/{questionId} {

  // Admin อ่านคำถามทั้งหมด
  // สมาชิกอ่านเฉพาะคำถามของตนเอง
  allow read: if isAdmin()
    || (
      isSignedIn()
      && resource.data.userId == request.auth.uid
    );

  // สมาชิกสร้างคำถามในชื่อตนเองเท่านั้น
  allow create: if isSignedIn()
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.status == "pending"
    && request.resource.data.keys().hasOnly([
      "userId",
      "userName",
      "userEmail",
      "subject",
      "detail",
      "status",
      "createdAt",
      "updatedAt"
    ]);

  // ระยะแรกยังไม่ให้แก้หรือลบคำถาม
  allow update: if isAdmin();
    allow delete: if false;
}

// =========================
// ประวัติการชำระเงิน
// =========================

match /payments/{paymentId} {
  // ผู้ดูแลที่ active อ่านและแสดงรายการชำระเงินได้
  allow read: if isAdmin();

  // ยังไม่อนุญาตให้แก้ไขหรือลบผ่านหน้าเว็บไซต์
  allow create: if request.auth != null
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.status == "pending"
      && request.resource.data.amount > 0
      && request.resource.data.plan in ["monthly", "yearly"];
    allow update: if isAdmin();
    allow delete: if false;
}
    // =========================
    // ปิดเส้นทางอื่นทั้งหมด
    // =========================

    match /appointments/{appointmentId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly([
          "userId", "userName", "userEmail", "caseType",
          "appointDate", "appointTime", "status", "createdAt"
        ]);
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
