  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  padding: 14px 16px;
  border: 1px solid rgba(215, 149, 105, 0.23);
  border-radius: 14px;
  background: rgba(7, 18, 38, 0.56);
}

.guide-list article > span {
  color: #e8ae80;
  font-size: 22px;
  font-weight: 900;
}

.guide-list h3,
.guide-list p {
  margin: 0;
}

.legal-disclaimer {
  margin-top: 20px;
  padding: 15px 17px;
  border-left: 4px solid #d68f5f;
  border-radius: 10px;
  color: rgba(251, 240, 233, 0.76);
  background: rgba(214, 143, 95, 0.08);
  line-height: 1.65;
}

.legal-disclaimer strong {
  color: #ffd2b1;
}

.legal-disclaimer p {
  margin: 4px 0 0;
}

.knowledge-empty {
  grid-column: 1 / -1;
  text-align: center;
}

@media (max-width: 1050px) {
  .legal-service-grid,
  .knowledge-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .legal-section {
    padding: 20px 14px;
  }

  .legal-section-heading,
  .knowledge-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .knowledge-toolbar input {
    width: 100%;
  }

  .guide-list article {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .legal-service-grid,
  .knowledge-grid {
    grid-template-columns: 1fr;
  }
}


/* ===== WORKING SITE SEARCH ===== */
.site-search-hit {
  border-color: #ffd09f !important;
  background: linear-gradient(
    135deg,
    rgba(214, 135, 82, 0.27),
    rgba(72, 52, 68, 0.78)
  ) !important;
  box-shadow:
    0 0 0 4px rgba(255, 208, 159, 0.16),
    0 16px 38px rgba(0, 0, 0, 0.28) !important;
  animation: siteSearchPulse 900ms ease-in-out 2;
}

@keyframes siteSearchPulse {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-3px) scale(1.012);
  }
}

@media (prefers-reduced-motion: reduce) {
  .site-search-hit {
    animation: none;
  }
}
