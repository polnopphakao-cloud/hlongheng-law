/* ===== COMPACT MEMBER DASHBOARD ===== */
.dashboard {
  grid-template-columns: 220px minmax(0, 1fr);
  background:
    radial-gradient(circle at 85% 8%, rgba(155, 91, 78, 0.12), transparent 30%),
    #07101f;
}

.dashboard > main {
  width: 100%;
  max-width: 1420px;
  margin: 0 auto;
  padding: 22px 26px 40px;
}

.dashboard aside {
  padding: 20px 14px;
  background:
    linear-gradient(180deg, rgba(49, 40, 57, 0.98), rgba(17, 24, 39, 0.98));
  border-right: 1px solid rgba(205, 139, 92, 0.28);
}

.dashboard aside button {
  min-height: 42px;
  padding: 9px 12px;
  border-radius: 11px;
  font-size: 14px;
}

.cards,
.adminGrid {
  gap: 14px;
}

.card {
  padding: 16px 18px;
  border: 1px solid rgba(191, 129, 91, 0.3);
  border-radius: 15px;
  background:
    linear-gradient(
      145deg,
      rgba(17, 30, 53, 0.96),
      rgba(31, 35, 55, 0.92)
    );
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.14);
}

.card h2,
.card h3 {
  margin: 0 0 12px;
  color: #fff2e8;
  font-size: clamp(18px, 2vw, 22px);
}

.card > h3 {
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(217, 150, 104, 0.24);
}

.listItem {
  display: grid;
  grid-template-columns: minmax(180px, 1.4fr) minmax(150px, 1fr) auto;
  align-items: center;
  gap: 14px;
  min-height: 68px;
  padding: 10px 4px;
  border-bottom: 1px solid rgba(133, 151, 180, 0.18);
  transition:
    background 160ms ease,
    transform 160ms ease,
    border-color 160ms ease;
}

.listItem:hover {
  padding-left: 10px;
  padding-right: 10px;
  border-color: rgba(218, 147, 98, 0.4);
  border-radius: 12px;
  background: rgba(182, 111, 82, 0.08);
  transform: translateY(-1px);
}

.listItem:last-child {
  border-bottom: 0;
}

.listItem strong {
  margin: 0;
  color: #ffd09f;
  font-size: 17px;
  line-height: 1.3;
}

.listItem p {
  margin: 3px 0 0;
  color: rgba(241, 244, 250, 0.78);
  font-size: 14px;
  line-height: 1.4;
}

.listItem .status {
  justify-self: end;
  min-height: 34px;
  padding: 6px 12px;
  font-size: 13px;
}

.card details {
  margin: 7px 0;
  overflow: hidden;
  border: 1px solid rgba(151, 164, 187, 0.18);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.025);
}

.card details[open] {
  border-color: rgba(216, 143, 96, 0.42);
  background: rgba(177, 105, 79, 0.07);
}

.card summary {
  min-height: 42px;
  display: flex;
  align-items: center;
  padding: 9px 12px;
  color: #f8eee9;
  cursor: pointer;
  font-weight: 700;
  list-style-position: inside;
}

.card summary:hover {
  color: #ffd0a8;
  background: rgba(206, 128, 83, 0.08);
}

.card details p {
  margin: 0;
  padding: 8px 14px;
  border-top: 1px solid rgba(151, 164, 187, 0.13);
  color: rgba(241, 244, 250, 0.78);
  font-size: 14px;
  line-height: 1.55;
}

.status {
  white-space: nowrap;
  letter-spacing: 0.01em;
}

@media (min-width: 1100px) {
  .cards {
    grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.85fr);
    align-items: start;
  }

  .cards > .card:first-child {
    grid-row: span 2;
  }
}

@media (max-width: 900px) {
  .dashboard {
    grid-template-columns: 1fr;
  }

  .dashboard aside {
    border-right: 0;
    border-bottom: 1px solid rgba(205, 139, 92, 0.28);
  }

  .dashboard > main {
    padding: 16px 12px 32px;
  }

  .listItem {
    grid-template-columns: minmax(0, 1fr) auto;
    min-height: 64px;
  }

  .listItem p {
    grid-column: 1;
  }

  .listItem .status {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
}

@media (max-width: 560px) {
  .card {
    padding: 14px 12px;
  }

  .listItem {
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 11px 3px;
  }

  .listItem .status {
    grid-column: 1;
    grid-row: auto;
    justify-self: start;
    margin-top: 4px;
  }
}

/* ===== COMPACT APPOINTMENT FORM ===== */
.appointment-compact-form {
  display: grid;
  grid-template-columns:
    minmax(150px, 1.25fr)
    minmax(160px, 1fr)
    minmax(130px, 0.8fr)
    auto;
  align-items: stretch;
  gap: 10px;
  margin-top: 14px;
}

.appointment-compact-form select,
.appointment-compact-form input,
.appointment-compact-form button {
  width: 100%;
  min-height: 46px;
  margin: 0;
  border-radius: 11px;
  font: inherit;
  box-sizing: border-box;
}

.appointment-compact-form select,
.appointment-compact-form input {
  padding: 9px 12px;
  color: #f9f4f1;
  border: 1px solid rgba(204, 137, 94, 0.42);
  background: rgba(8, 20, 40, 0.78);
  outline: none;
}

.appointment-compact-form select {
  cursor: pointer;
}

.appointment-compact-form select option {
  color: #111827;
  background: #ffffff;
}

.appointment-compact-form input::-webkit-calendar-picker-indicator {
  padding: 5px;
  border-radius: 6px;
  background-color: rgba(255, 226, 204, 0.88);
  cursor: pointer;
}

.appointment-compact-form select:focus,
.appointment-compact-form input:focus {
  border-color: #dfa06f;
  box-shadow: 0 0 0 3px rgba(213, 132, 82, 0.16);
}

.appointment-compact-form button {
  min-width: 170px;
  padding: 9px 18px;
  color: #321d17;
  border: 1px solid #ebb181;
  background: linear-gradient(135deg, #ffe2bd, #d68c57 58%, #ba7046);
  box-shadow: 0 8px 20px rgba(91, 45, 31, 0.28);
  cursor: pointer;
  font-weight: 800;
  white-space: nowrap;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    filter 160ms ease;
}

.appointment-compact-form button:hover:not(:disabled) {
  transform: translateY(-2px);
  filter: brightness(1.06);
  box-shadow: 0 11px 26px rgba(105, 52, 34, 0.38);
}

.appointment-compact-form button:disabled {
  cursor: wait;
  opacity: 0.62;
}

.appointment-compact-form button:focus-visible {
  outline: 3px solid #ffd4b1;
  outline-offset: 3px;
}

@media (max-width: 1050px) {
  .appointment-compact-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .appointment-compact-form button {
    min-width: 0;
  }
