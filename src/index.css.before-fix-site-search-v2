/* ===== WOW NAVIGATION ===== */
.wow-nav {
  position: sticky;
  top: 14px;
  z-index: 50;
  width: min(1180px, calc(100% - 24px));
  margin: 0 auto 24px;
  border: 1px solid rgba(212, 175, 55, 0.55);
  border-radius: 22px;
  background:
    linear-gradient(135deg, rgba(5, 20, 48, 0.94), rgba(13, 43, 88, 0.88));
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.35),
    0 0 28px rgba(212, 175, 55, 0.09);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.wow-nav-inner {
  min-height: 76px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.wow-brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  min-width: max-content;
  padding: 8px 10px;
  border: 0;
  color: #fff;
  background: transparent;
  cursor: pointer;
  text-align: left;
  border-radius: 14px;
}

.wow-brand:hover {
  background: rgba(255, 255, 255, 0.06);
  transform: translateY(-1px);
}

.wow-brand-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(240, 202, 88, 0.75);
  border-radius: 14px;
  color: #f2cd65;
  background: linear-gradient(145deg, rgba(240, 202, 88, 0.18), rgba(255, 255, 255, 0.03));
  box-shadow: inset 0 0 18px rgba(240, 202, 88, 0.08);
  font-size: 24px;
}

.wow-brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.05;
}

.wow-brand-text strong {
  color: #f8df8a;
  letter-spacing: 0.12em;
  font-size: 15px;
}

.wow-brand-text small {
  margin-top: 5px;
  color: rgba(255, 255, 255, 0.68);
  letter-spacing: 0.16em;
  font-size: 9px;
}

.wow-nav-links {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.wow-nav-links button {
  min-height: 44px;
  padding: 10px 14px;
  border: 1px solid transparent;
  border-radius: 13px;
  color: rgba(255, 255, 255, 0.88);
  background: transparent;
  cursor: pointer;
  font: inherit;
  font-weight: 700;
  white-space: nowrap;
  transition:
    color 160ms ease,
    border-color 160ms ease,
    background 160ms ease,
    transform 160ms ease,
    box-shadow 160ms ease;
}

.wow-nav-links button:hover {
  color: #ffe48b;
  border-color: rgba(240, 202, 88, 0.4);
  background: rgba(240, 202, 88, 0.09);
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.2);
}

.wow-nav-links .wow-login {
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.06);
}

.wow-nav-links .wow-consult {
  color: #102346;
  border-color: #f4d878;
  background: linear-gradient(135deg, #f9e79c, #d7a92e);
  box-shadow: 0 8px 24px rgba(215, 169, 46, 0.25);
}

.wow-nav-links .wow-consult:hover {
  color: #07172f;
  background: linear-gradient(135deg, #fff2b7, #e5b83a);
  box-shadow: 0 10px 30px rgba(229, 184, 58, 0.38);
}

.wow-menu-toggle {
  width: 48px;
  height: 46px;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  border: 1px solid rgba(240, 202, 88, 0.55);
  border-radius: 13px;
  color: #fff;
  background: rgba(255, 255, 255, 0.05);
  cursor: pointer;
}

.wow-menu-toggle span {
  width: 22px;
  height: 2px;
  border-radius: 99px;
  background: #f5d66f;
}

.wow-search {
  padding: 0 18px 18px;
  animation: wowSearchIn 180ms ease-out;
}

.wow-search label {
  display: block;
  margin: 0 0 7px 3px;
  color: #f6dda0;
  font-size: 13px;
  font-weight: 700;
}

.wow-search-box {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 8px;
}

.wow-search-box input {
  width: 100%;
  min-height: 48px;
  padding: 11px 16px;
  border: 1px solid rgba(240, 202, 88, 0.5);
  border-radius: 14px;
  outline: none;
  color: #fff;
  background: rgba(2, 12, 32, 0.72);
  font: inherit;
}

.wow-search-box input::placeholder {
  color: rgba(255, 255, 255, 0.52);
}

.wow-search-box input:focus {
  border-color: #f2cf69;
  box-shadow: 0 0 0 4px rgba(242, 207, 105, 0.14);
}

.wow-search-box button {
  min-height: 48px;
  padding: 10px 18px;
  border: 1px solid #e9c65b;
  border-radius: 14px;
  color: #102346;
  background: linear-gradient(135deg, #f8e49b, #d5a62a);
  cursor: pointer;
  font: inherit;
  font-weight: 800;
}

.wow-search-box .wow-search-close {
  width: 48px;
  padding: 0;
  color: #fff;
  border-color: rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.07);
}

.wow-nav button:focus-visible,
.wow-search input:focus-visible {
  outline: 3px solid #ffe895;
  outline-offset: 3px;
}

@keyframes wowSearchIn {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .wow-nav {
    top: 8px;
    width: min(100% - 16px, 760px);
    border-radius: 18px;
  }

  .wow-menu-toggle {
    display: flex;
  }

  .wow-nav-links {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    display: none;
    padding: 12px;
    border: 1px solid rgba(212, 175, 55, 0.48);
    border-radius: 18px;
    background: rgba(4, 18, 44, 0.98);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(18px);
  }

  .wow-nav-links.is-open {
    display: grid;
    animation: wowSearchIn 180ms ease-out;
  }

  .wow-nav-links button {
    width: 100%;
    min-height: 48px;
    text-align: left;
  }

  .wow-nav-links .wow-consult,
  .wow-nav-links .wow-login {
    text-align: center;
  }

  .wow-search {
    padding: 8px 12px 14px;
  }
}

@media (max-width: 520px) {
  .wow-brand-text strong {
    font-size: 13px;
  }

  .wow-brand-text small {
    font-size: 8px;
  }

  .wow-brand-icon {
    width: 40px;
    height: 40px;
  }

  .wow-search-box {
    grid-template-columns: 1fr auto;
  }

  .wow-search-box input {
    grid-column: 1 / -1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .wow-nav *,
  .wow-search * {
    animation: none !important;
    scroll-behavior: auto !important;
    transition: none !important;
  }
}

