        </form>

        {notice && <p className="notice">{notice}</p>}

        {remaining === 0 && (
          <p className="notice">
            สิทธิ์คำถามหมดหรือยังไม่ได้รับสิทธิ์ กรุณาติดต่อผู้ดูแล
          </p>
