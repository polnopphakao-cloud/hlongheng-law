import { useEffect, useState } from "react";
import {
  createUserWithEmailAndPassword,
  onAuthStateChanged,
  signInWithEmailAndPassword,
  sendPasswordResetEmail,
  signOut,
  updateProfile,
} from "firebase/auth";
import {
  collection,
  addDoc,
  doc,
  getCountFromServer,
  getDoc,
  getDocs,
  limit,
  orderBy,
  query,
 where,
  runTransaction,
  serverTimestamp,
  setDoc,
  updateDoc,
  onSnapshot,
} from "firebase/firestore";
import { httpsCallable } from "firebase/functions";
import { auth, db, functions } from "./lib/firebase";
import AdminMemberManager from "./components/AdminMemberManager";
import AdminPageRouter from "./components/AdminPageRouter";
import LegalContentHub from "./components/LegalContentHub";

const empty = { name: "", email: "", password: "" };

export default function App() {
  const [user, setUser] = useState(null);
  const [profile, setProfile] = useState(null);
  const [isAdmin, setIsAdmin] = useState(false);
  const [mode, setMode] = useState("home");
  const [form, setForm] = useState(empty);
  const [msg, setMsg] = useState("");
  const [menuOpen, setMenuOpen] = useState(false);
  const [searchOpen, setSearchOpen] = useState(false);

  useEffect(
    () =>
      onAuthStateChanged(auth, async (u) => {
        setUser(u);
        if (!u) {
          setProfile(null);
          setIsAdmin(false);
          setMode("home");
          return;
        }
        const [profileSnap, adminSnap] = await Promise.all([
          getDoc(doc(db, "users", u.uid)),
          getDoc(doc(db, "admins", u.uid)),
        ]);
        setProfile(profileSnap.exists() ? profileSnap.data() : null);
        setIsAdmin(adminSnap.exists() && adminSnap.data().active === true);
        setMode("dashboard");
      }),
    [],
  );

  async function register(e) {
    e.preventDefault();
    setMsg("");
    try {
      const c = await createUserWithEmailAndPassword(
        auth,
        form.email,
        form.password,
      );
      await updateProfile(c.user, { displayName: form.name });
      await setDoc(doc(db, "users", c.user.uid), {
        name: form.name,
        email: form.email,
        role: "member",
        plan: "free",
        questionLimit: 5,
        questionUsed: 0,
        status: "active",
        createdAt: serverTimestamp(),
      });
      setMsg("สมัครสมาชิกสำเร็จ");
    } catch (err) {
      setMsg(err.message);
    }
  }

  async function login(e) {
    e.preventDefault();
    setMsg("");
    try {
      await signInWithEmailAndPassword(auth, form.email, form.password);
    } catch (err) {
      setMsg(err.message);
    }
  }

  async function resetPassword() {
    const email = form.email.trim();
    if (!email) {
      setMsg("กรุณากรอกอีเมลก่อนขอรีเซ็ตรหัสผ่าน");
      return;
    }
    setMsg("");
    try {
      await sendPasswordResetEmail(auth, email);
      setMsg("ส่งลิงก์ตั้งรหัสผ่านใหม่ไปยังอีเมลแล้ว กรุณาตรวจสอบกล่องจดหมาย");
    } catch (err) {
      setMsg("ไม่สามารถส่งลิงก์ตั้งรหัสผ่านได้ กรุณาตรวจสอบอีเมลแล้วลองใหม่");
    }
  }

  if (mode === "auth")
    return (
      <Auth
        {...{ form, setForm, register, login, resetPassword, msg }}
        back={() => setMode("home")}
      />
    );
  if (user && mode === "dashboard")
    return (
      <Dashboard
        {...{ user, profile, isAdmin }}
        logout={() => signOut(auth)}
        home={() => setMode("home")}
      />
    );

  return (
    <main className="page">
<nav className="wow-nav" aria-label="เมนูหลัก">
        <div className="wow-nav-inner">
          <button
            type="button"
            className="wow-brand"
            onClick={() => window.scrollTo({ top: 0, behavior: "smooth" })}
            aria-label="กลับสู่หน้าแรก"
          >
            <span className="wow-brand-icon">⚖</span>
            <span className="wow-brand-text">
              <strong>NOPPAKAO</strong>
              <small>LAW OFFICE</small>
            </span>
          </button>

          <button
            type="button"
            className="wow-menu-toggle"
            aria-expanded={menuOpen}
            aria-controls="main-navigation"
            aria-label={menuOpen ? "ปิดเมนู" : "เปิดเมนู"}
            onClick={() => setMenuOpen((open) => !open)}
          >
            <span />
            <span />
            <span />
          </button>

          <div
            id="main-navigation"
            className={`wow-nav-links ${menuOpen ? "is-open" : ""}`}
          >
            <button
              type="button"
              onClick={() => {
                window.scrollTo({ top: 0, behavior: "smooth" });
                setMenuOpen(false);
              }}
            >
              หน้าแรก
            </button>

            <button
              type="button"
              onClick={() => {
                document.getElementById("legal-services")?.scrollIntoView({
                  behavior: "smooth",
                  block: "start",
                });
                setMenuOpen(false);
              }}
            >
              บริการกฎหมาย
            </button>

            <button
              type="button"
              onClick={() => {
                document.getElementById("legal-knowledge")?.scrollIntoView({
                  behavior: "smooth",
                  block: "start",
                });
                setMenuOpen(false);
              }}
            >
              คลังความรู้
            </button>

            <button
              type="button"
              aria-expanded={searchOpen}
              onClick={() => {
                setSearchOpen((open) => !open);
                setMenuOpen(false);
              }}
            >
              🔎 ค้นหา
            </button>

            <button
              type="button"
              className="wow-login"
              onClick={() => setMode(user ? "dashboard" : "auth")}
            >
              {user ? "แดชบอร์ด" : "เข้าสู่ระบบ"}
            </button>

            <button
              type="button"
              className="wow-consult"
              onClick={() => setMode(user ? "dashboard" : "auth")}
            >
              ปรึกษาคดี
            </button>
          </div>
        </div>

        {searchOpen && (
          <form
            className="wow-search"
            role="search"
            onSubmit={(event) => {
              event.preventDefault();

              const query = String(
                new FormData(event.currentTarget)
                  .get("siteSearch") || "",
              )
                .trim()
                .toLocaleLowerCase("th-TH");

              if (!query) {
                alert("กรุณาพิมพ์คำที่ต้องการค้นหา");
                return;
              }

              const candidates = Array.from(
                document.querySelectorAll(
                  [
                    ".legal-service-card",
                    ".knowledge-card",
                    ".guide-list article",
                    ".free-member-offer",
                    ".hero",
                  ].join(","),
                ),
              );

              const match = candidates.find((element) =>
                String(element.textContent || "")
                  .toLocaleLowerCase("th-TH")
                  .includes(query),
              );

              if (!match) {
                alert(`ไม่พบคำว่า “${query}” ในบริการหรือคลังความรู้`);
                return;
              }

              setSearchOpen(false);
              setMenuOpen(false);

              window.setTimeout(() => {
                match.scrollIntoView({
                  behavior: "smooth",
                  block: "center",
                });

                match.classList.add("site-search-hit");
                window.setTimeout(
                  () => match.classList.remove("site-search-hit"),
                  2600,
                );
              }, 80);
            }}
          >
            <label htmlFor="site-search">ค้นหาข้อมูลในเว็บไซต์</label>

            <div className="wow-search-box">
              <input
                id="site-search"
                name="siteSearch"
                type="search"
                placeholder="ค้นหา เช่น คดีมรดก ที่ดิน สัญญา..."
                autoFocus
              />

              <button type="submit">ค้นหา</button>

              <button
                type="button"
                className="wow-search-close"
                onClick={() => setSearchOpen(false)}
                aria-label="ปิดช่องค้นหา"
              >
                ✕
              </button>
            </div>
          </form>
        )}
      </nav>
      <section className="hero">
        <div className="logo">⚖</div>
        <p className="eyebrow">NOPPAKAO LAW OFFICE</p>
        <h1>สำนักงานกฎหมายนพเก้า ทนายความ</h1>
        <p className="subtitle">รับว่าความคดีแพ่งและคดีอาญาทั่วราชอาณาจักร</p>
        <p className="description">
          ให้คำปรึกษา วิเคราะห์ข้อกฎหมาย และดำเนินคดี
          โดยยึดมั่นในความสุจริตและหลักนิติธรรม
        </p>
        <div className="actions">
 <button className="primary" onClick={() => setMode(user ? "dashboard" : "auth")}>ปรึกษาคดี</button>
          <button
            className="secondary"
            onClick={() => setMode(user ? "dashboard" : "auth")}
          >
            {user ? "แดชบอร์ด" : "สมัครสมาชิก / เข้าสู่ระบบ"}
          </button>
        </div>
      </section>

      <section className="free-member-offer" aria-labelledby="free-member-title">
        <div className="free-member-icon" aria-hidden="true">✓</div>

        <div className="free-member-copy">
          <span className="free-member-label">สิทธิสำหรับสมาชิกใหม่</span>
          <h2 id="free-member-title">
            สมัครสมาชิกฟรี รับสิทธิถามกฎหมาย 5 คำถาม
          </h2>
          <p>
            เมื่อใช้สิทธิครบแล้ว เลือกแพ็กเกจรายเดือน รายปี หรือ VIP
            ได้ตามต้องการ
          </p>
        </div>

        <button
          type="button"
          className="free-member-button"
          onClick={() => setMode(user ? "dashboard" : "auth")}
        >
          {user ? "ไปที่แดชบอร์ด" : "สมัครสมาชิกฟรี"}
        </button>
      </section>

      <LegalContentHub
        onConsult={() => setMode(user ? "dashboard" : "auth")}
      />
    </main>
  );
}

function Auth({ form, setForm, register, login, resetPassword, msg, back }) {
  const [tab, setTab] = useState("register");
  return (
    <main className="page">
      <section className="panel auth">
        <button className="link" onClick={back}>
          ← หน้าแรก
        </button>
        <h2>{tab === "register" ? "สมัครสมาชิก" : "เข้าสู่ระบบ"}</h2>
        <form onSubmit={tab === "register" ? register : login}>
          {tab === "register" && (
            <input
              required
              placeholder="ชื่อ-นามสกุล"
              value={form.name}
              onChange={(e) => setForm({ ...form, name: e.target.value })}
            />
          )}
          <input
            required
            type="email"
            placeholder="อีเมล"
            value={form.email}
            onChange={(e) => setForm({ ...form, email: e.target.value })}
          />
          <input
            required
            minLength="8"
            type="password"
            placeholder="รหัสผ่านอย่างน้อย 8 ตัว"
            value={form.password}
            onChange={(e) => setForm({ ...form, password: e.target.value })}
          />
          <button className="primary" type="submit">
            {tab === "register" ? "สมัครสมาชิก" : "เข้าสู่ระบบ"}
          </button>
        {tab === "login" && <button className="link" type="button" onClick={resetPassword}>ลืมรหัสผ่าน?</button>}
        </form>
        {msg && <p className="notice">{msg}</p>}
        <button
          className="link"
          onClick={() => setTab(tab === "register" ? "login" : "register")}
        >
          {tab === "register"
            ? "มีบัญชีแล้ว เข้าสู่ระบบ"
            : "ยังไม่มีบัญชี สมัครสมาชิก"}
        </button>
      </section>
    </main>
  );
}

function Dashboard({ user, profile, isAdmin, logout, home }) {
  return (
    <main className="dashboard">
      <aside className="dashboard-sidebar">
        <div className="brand">⚖ นพเก้า</div>
        <button onClick={home}>หน้าเว็บไซต์</button>
        <button type="button" onClick={() => document.getElementById(isAdmin ? "admin-summary" : "member-info")?.scrollIntoView({ behavior: "smooth", block: "start" })}>ข้อมูลสมาชิก</button>
        <button type="button" onClick={() => document.getElementById(isAdmin ? "admin-questions" : "consultation-form")?.scrollIntoView({ behavior: "smooth", block: "start" })}>คำถามปรึกษา</button>
        {isAdmin && (
          <>
          <button type="button" onClick={() => document.getElementById("admin-members")?.scrollIntoView({ behavior: "smooth", block: "start" })}>จัดการสมาชิก</button>
          <button type="button" onClick={() => document.getElementById("admin-payments")?.scrollIntoView({ behavior: "smooth", block: "start" })}>การชำระเงิน</button>
          <button type="button" onClick={() => document.getElementById("admin-appointments")?.scrollIntoView({ behavior: "smooth", block: "start" })}>จัดการนัดหมาย</button>
          </>
        )}
        <button className="sidebar-logout" onClick={logout}>ออกจากระบบ</button>
      </aside>
      <section className="content">
        <p className="eyebrow">
          {isAdmin ? "ADMIN CONTROL CENTER" : "MEMBER CENTER"}
        </p>
        <h2>สวัสดี {profile?.name || user.displayName || user.email}</h2>
        {isAdmin ? (
          <AdminDashboard />
        ) : (
          <MemberDashboard user={user} profile={profile} />
        )}
      </section>
    </main>
  );
}
function appointmentStatusLabel(status) {
  const labels = {
    pending: "รอยืนยัน",
    confirmed: "ยืนยันแล้ว",
    completed: "เสร็จสิ้น",
    cancelled: "ยกเลิกแล้ว",
  };
  return labels[status] || status || "รอยืนยัน";
}

function adminStatusLabel(status) {
  const labels = {
    pending: "รอดำเนินการ",
    answered: "ตอบแล้ว",
    approved: "อนุมัติแล้ว",
    rejected: "ไม่อนุมัติ",
  };
  return labels[status] || status || "รอดำเนินการ";
}


function MemberDashboard({ user, profile }) {
  const [title, setTitle] = useState("");
  const [detail, setDetail] = useState("");
  const [sending, setSending] = useState(false);
  const [notice, setNotice] = useState("");
  const [used, setUsed] = useState(profile?.questionUsed || 0);
  const paymentPlans = {
    monthly_99: {
      label: "รายเดือน",
      amount: 99,
      duration: "30 วัน",
      questionLimit: 20,
      dailyQuestionLimit: 1,
    },
    monthly_199: {
      label: "รายเดือนพิเศษ",
      amount: 199,
      duration: "30 วัน",
      questionLimit: 45,
      dailyQuestionLimit: 2,
    },
    yearly: {
      label: "รายปี",
      amount: 999,
      duration: "1 ปี",
      questionLimit: 230,
      dailyQuestionLimit: 5,
    },
    vip: {
      label: "VIP",
      amount: 1999,
      duration: "3 ปี",
      questionLimit: 700,
      dailyQuestionLimit: 8,
    },
  };

  const [paymentPlan, setPaymentPlan] = useState("monthly_99");
  const [sendingPayment, setSendingPayment] = useState(false);
  const [paymentNotice, setPaymentNotice] = useState("");
  const [appointment, setAppointment] = useState({ caseType: "คดีมรดก", appointDate: "", appointTime: "" });
  const [appointmentNotice, setAppointmentNotice] = useState("");
 const [memberAppointments, setMemberAppointments] = useState([]);
  const [memberQuestions, setMemberQuestions] = useState([]);
  const [sendingAppointment, setSendingAppointment] = useState(false);

  useEffect(() => {
    let active = true;

    async function loadMemberAppointments() {
      try {
        const appointmentSnap = await getDocs(
          query(collection(db, "appointments"), where("userId", "==", user.uid))
        );
        if (active) {
          setMemberAppointments(
            appointmentSnap.docs.map((item) => ({ id: item.id, ...item.data() }))
          );
        }
      } catch (e) {
        if (active) setAppointmentNotice(e.message);
      }
    }

    if (user?.uid) { loadMemberAppointments(); getDocs(query(collection(db, "questions"), where("userId", "==", user.uid))).then((snap) => { if (active) setMemberQuestions(snap.docs.map((item) => ({ id: item.id, ...item.data() }))); }).catch((e) => { if (active) setNotice(e.message); }); }
    return () => { active = false; };
  }, [user?.uid]);

  const limitValue = profile?.questionLimit || 0;
  const remaining = Math.max(limitValue - used, 0);
  const canSubmit =
    profile?.status === "active" &&
    remaining > 0 &&
    title.trim().length >= 3 &&
    detail.trim().length >= 10;

  async function submitQuestion(e) {
    e.preventDefault();
    setNotice("");

    if (!user) {
      setNotice("กรุณาเข้าสู่ระบบก่อนส่งคำถาม");
      return;
    }

    const subject = title.trim();
    const questionDetail = detail.trim();

    if (subject.length < 3) {
      setNotice("หัวข้อคำถามต้องมีอย่างน้อย 3 ตัวอักษร");
      return;
    }

    if (questionDetail.length < 10) {
      setNotice(
        "รายละเอียดคำถามต้องมีอย่างน้อย 10 ตัวอักษร",
      );
      return;
    }

    setSending(true);

    try {
      const submitQuestionSecure = httpsCallable(
        functions,
        "submitQuestionSecure",
      );

      const response = await submitQuestionSecure({
        subject,
        detail: questionDetail,
      });

      const result = response.data || {};

      if (!result.ok) {
        throw new Error(
          result.message || "ไม่สามารถส่งคำถามได้",
        );
      }

      setUsed(
        Number(
          result.questionUsed ??
            profile?.questionUsed ??
            0,
        ),
      );

      setTitle("");
      setDetail("");
      setNotice(
        result.message || "ส่งคำถามเรียบร้อยแล้ว",
      );
    } catch (error) {
      console.error("submitQuestion error:", error);

      const message =
        error?.details ||
        error?.message ||
        "ไม่สามารถส่งคำถามได้";

      setNotice(message);
    } finally {
      setSending(false);
    }
  }

  async function submitPayment(e) {
    e.preventDefault();
    setPaymentNotice("");

    const selectedPlan = paymentPlans[paymentPlan];

    if (!selectedPlan) {
      setPaymentNotice("ไม่พบแพ็กเกจที่เลือก");
      return;
    }

    const amount = selectedPlan.amount;

    setSendingPayment(true);
    try {
      const paymentRef = doc(collection(db, "payments"));
      await setDoc(paymentRef, {
        userId: user.uid,
        userName: profile?.name || user.displayName || "",
        userEmail: profile?.email || user.email || "",
        plan: paymentPlan,
        amount,
        status: "pending",
        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp(),
      });
      const response = await fetch(
        "https://us-central1-hlongheng-law.cloudfunctions.net/createCheckoutSession",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
          paymentId: paymentRef.id,
          returnUrl: window.location.origin,
        }),
        }
      );

      const checkout = await response.json();

      if (!response.ok || !checkout.url) {
        throw new Error(checkout.error || "ไม่สามารถเปิดหน้าชำระเงินได้");
      }

      window.location.href = checkout.url;
      setPaymentNotice("แจ้งชำระเงินเรียบร้อยแล้ว รอผู้ดูแลตรวจสอบ");
    } catch (error) {
      setPaymentNotice(error.message);
    } finally {
      setSendingPayment(false);
    }
  }

    async function submitAppointment(e) {
    e.preventDefault();
    setAppointmentNotice("");

    if (!appointment.appointDate || !appointment.appointTime) {
      setAppointmentNotice("กรุณาเลือกวันและเวลานัดหมาย");
      return;
    }

  const selectedAppointmentDateTime = new Date(
    `${appointment.appointDate}T${appointment.appointTime}`
  );
  if (Number.isNaN(selectedAppointmentDateTime.getTime()) || selectedAppointmentDateTime < new Date()) {
    setAppointmentNotice("กรุณาเลือกวันและเวลานัดหมายในอนาคต");
    return;
  }

    setSendingAppointment(true);

    try {
      await addDoc(collection(db, "appointments"), {
        userId: user.uid,
        userName: profile?.name || user.displayName || "",
        userEmail: profile?.email || user.email || "",
        caseType: appointment.caseType,
        appointDate: appointment.appointDate,
        appointTime: appointment.appointTime,
        status: "pending",
        createdAt: serverTimestamp(),
      });

      setAppointment({
        caseType: "คดีมรดก",
        appointDate: "",
        appointTime: "",
      });

      setAppointmentNotice("ส่งคำขอนัดหมายเรียบร้อยแล้ว");
    } catch (error) {
      setAppointmentNotice(error.message);
    } finally {
      setSendingAppointment(false);
    }
  }
  return (
    <>
      <div id="member-info" className="cards">
        <Card
            title="สถานะสมาชิก"
            value={
              {
                free: "ฟรี",
                monthly_99: "รายเดือน",
                monthly_199: "รายเดือนพิเศษ",
                monthly: "รายเดือน",
                yearly: "รายปี",
                vip: "VIP",
              }[profile?.plan] || "ฟรี"
            }
          />
        <Card title="สิทธิ์คำถาม" value={`${used} / ${limitValue}`} />
        <Card title="สิทธิ์คงเหลือ" value={remaining} />
        <Card
            title="สถานะบัญชี"
            value={
              {
                active: "ใช้งาน",
                inactive: "ระงับการใช้งาน",
                suspended: "ถูกระงับ",
              }[profile?.status] || "ใช้งาน"
            }
          />
      </div>

      <section id="consultation-form" className="panel">
        <h3>ส่งคำถามปรึกษา</h3>
        <p>กรอกหัวข้อและรายละเอียดคำถามให้ครบถ้วน</p>

        <form className="question-compact-form" onSubmit={submitQuestion}>
          <input
            required
            minLength="3"
            placeholder="หัวข้อคำถาม"
            value={title}
            onChange={(e) => setTitle(e.target.value)}
          />

          <textarea
            required
            minLength="10"
            rows="7"
            placeholder="รายละเอียดคำถาม อย่างน้อย 10 ตัวอักษร"
            value={detail}
            onChange={(e) => setDetail(e.target.value)}
